# Copy to .env (git ignores it). The same names go in GitHub Actions secrets.

# Meta system user token: posts to your Page and Instagram (see the setup skill)
META_SYSTEM_USER_TOKEN=

# Claude Code token for the desk workflow: run `claude setup-token`
CLAUDE_CODE_OAUTH_TOKEN=

# Desk app (phone): a fine-grained GitHub token for this repo only, and the
# password that unlocks it (16+ characters). Only an encrypted copy is published.
ADMIN_GITHUB_TOKEN=
ADMIN_PASSWORD=
